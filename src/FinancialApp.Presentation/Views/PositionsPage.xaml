<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FinancialApp.Presentation.Views.PositionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource AppBackgroundBrush}">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="12">
            <TextBlock Text="POSITIONS" Style="{StaticResource SubheaderTextStyle}"/>
            <TextBlock Text="Portfolio holdings, P&amp;L, concentration, and risk exposure" Foreground="{ThemeResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Portfolio Summary Cards -->
        <Grid Grid.Row="1" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Summary Row -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Positions Value -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="TOTAL MARKET VALUE" Style="{StaticResource MetricLabelStyle}"/>
                        <TextBlock Text="$840,000.00" Style="{StaticResource MetricValueStyle}"/>
                        <TextBlock Text="12 positions open" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Total Cost Basis -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="TOTAL COST BASIS" Style="{StaticResource MetricLabelStyle}"/>
                        <TextBlock Text="$815,700.00" Style="{StaticResource MetricValueStyle}"/>
                        <TextBlock Text="Entry cost" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Unrealized P&L -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="UNREALIZED P&amp;L" Style="{StaticResource MetricLabelStyle}"/>
                        <TextBlock Text="+$24,300.00" Style="{StaticResource MetricValueStyle}" Foreground="{ThemeResource PositiveBrush}"/>
                        <TextBlock Text="+2.98%" Foreground="{ThemeResource PositiveBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Max Concentration -->
                <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="MAX CONCENTRATION" Style="{StaticResource MetricLabelStyle}"/>
                        <TextBlock Text="MSFT: 8.4%" Style="{StaticResource MetricValueStyle}"/>
                        <TextBlock Text="Within limits" Foreground="{ThemeResource PositiveBrush}" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Positions Table -->
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header Row -->
                    <Grid Grid.Row="0" Padding="16" Background="{ThemeResource ElevationBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="SYMBOL" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="QUANTITY" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock Grid.Column="2" Text="AVG COST" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock Grid.Column="3" Text="CURR PRICE" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock Grid.Column="4" Text="MARKET VALUE" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock Grid.Column="5" Text="UNREALIZED P&amp;L" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock Grid.Column="6" Text="% P&amp;L" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock Grid.Column="7" Text="CONC. %" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock Grid.Column="8" Text="SECTOR" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock Grid.Column="9" Text="ACTION" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12"/>
                    </Grid>

                    <!-- Data Rows -->
                    <ListView Grid.Row="1" Background="Transparent" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="16,12" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Symbol -->
                                    <TextBlock Text="AAPL" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>

                                    <!-- Quantity -->
                                    <TextBlock Grid.Column="1" Text="100" Foreground="{ThemeResource TextPrimaryBrush}"/>

                                    <!-- Avg Cost -->
                                    <TextBlock Grid.Column="2" Text="$208.20" Foreground="{ThemeResource TextSecondaryBrush}"/>

                                    <!-- Current Price -->
                                    <TextBlock Grid.Column="3" Text="$211.40" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>

                                    <!-- Market Value -->
                                    <TextBlock Grid.Column="4" Text="$21,140.00" Foreground="{ThemeResource TextPrimaryBrush}"/>

                                    <!-- Unrealized P&L -->
                                    <TextBlock Grid.Column="5" Text="+$320.00" Foreground="{ThemeResource PositiveBrush}" FontWeight="SemiBold"/>

                                    <!-- % P&L -->
                                    <TextBlock Grid.Column="6" Text="+0.15%" Foreground="{ThemeResource PositiveBrush}"/>

                                    <!-- Concentration % -->
                                    <TextBlock Grid.Column="7" Text="2.5%" Foreground="{ThemeResource TextSecondaryBrush}"/>

                                    <!-- Sector -->
                                    <TextBlock Grid.Column="8" Text="Tech" Foreground="{ThemeResource TextSecondaryBrush}"/>

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Button Content="SELL" Style="{StaticResource SecondaryButtonStyle}" Padding="8,6" FontSize="11"/>
                                        <Button Content="CHART" Style="{StaticResource SecondaryButtonStyle}" Padding="8,6" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                        <!-- Sample Rows -->
                        <ListViewItem/>
                        <ListViewItem/>
                        <ListViewItem/>
                        <ListViewItem/>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
