<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FinancialApp.Presentation.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource AppBackgroundBrush}">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="12">
            <TextBlock Text="REPORTS" Style="{StaticResource SubheaderTextStyle}"/>
            <TextBlock Text="Portfolio analysis, trading activity, compliance, and performance reports" Foreground="{ThemeResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Report Selector and Export -->
        <Grid Grid.Row="1" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Report Selection -->
            <StackPanel Spacing="12">
                <TextBlock Text="SELECT REPORT TYPE" Style="{StaticResource SectionHeaderStyle}"/>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Header="Report Type" Background="{ThemeResource SurfaceBrush}" Foreground="{ThemeResource TextPrimaryBrush}">
                        <ComboBoxItem Content="Daily P&amp;L" IsSelected="True"/>
                        <ComboBoxItem Content="Position Report"/>
                        <ComboBoxItem Content="Trade Activity"/>
                        <ComboBoxItem Content="Risk Summary"/>
                        <ComboBoxItem Content="Compliance Report"/>
                    </ComboBox>

                    <ComboBox Grid.Column="1" Header="Period" Background="{ThemeResource SurfaceBrush}" Foreground="{ThemeResource TextPrimaryBrush}">
                        <ComboBoxItem Content="Today" IsSelected="True"/>
                        <ComboBoxItem Content="This Week"/>
                        <ComboBoxItem Content="This Month"/>
                        <ComboBoxItem Content="Custom"/>
                    </ComboBox>

                    <ComboBox Grid.Column="2" Header="Format" Background="{ThemeResource SurfaceBrush}" Foreground="{ThemeResource TextPrimaryBrush}">
                        <ComboBoxItem Content="View" IsSelected="True"/>
                        <ComboBoxItem Content="PDF"/>
                        <ComboBoxItem Content="Excel"/>
                        <ComboBoxItem Content="CSV"/>
                    </ComboBox>

                    <Button Grid.Column="3" Content="GENERATE" Style="{StaticResource PrimaryButtonStyle}"/>
                </Grid>
            </StackPanel>

            <!-- Report Content -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="DAILY P&amp;L REPORT" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- Summary Section -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="{ThemeResource ElevationBrush}" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Opening Value" Style="{StaticResource MetricLabelStyle}"/>
                                <TextBlock Text="$1,230,010.00" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{ThemeResource ElevationBrush}" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Closing Value" Style="{StaticResource MetricLabelStyle}"/>
                                <TextBlock Text="$1,254,310.00" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{ThemeResource ElevationBrush}" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Daily P&amp;L" Style="{StaticResource MetricLabelStyle}"/>
                                <TextBlock Text="+$24,300.00" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource PositiveBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Trading Activity -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="TRADING ACTIVITY" Style="{StaticResource SectionHeaderStyle}"/>
                        <Grid Padding="12" Background="{ThemeResource ElevationBrush}" CornerRadius="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Total Trades" Style="{StaticResource MetricLabelStyle}"/>
                                <TextBlock Text="42" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Buy Orders" Style="{StaticResource MetricLabelStyle}"/>
                                <TextBlock Text="24" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource PositiveBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Sell Orders" Style="{StaticResource MetricLabelStyle}"/>
                                <TextBlock Text="18" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource NegativeBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Total Volume" Style="{StaticResource MetricLabelStyle}"/>
                                <TextBlock Text="2.8M shares" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Position Changes -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="TOP POSITION CHANGES" Style="{StaticResource SectionHeaderStyle}"/>
                        <Grid Padding="12" Background="{ThemeResource ElevationBrush}" CornerRadius="8" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}">SYMBOL</TextBlock>
                            <TextBlock Grid.Column="1" Text="CHANGE" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="RESULT" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="3"/>
                        </Grid>

                        <Grid Padding="12" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="AAPL" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="+100" Foreground="{ThemeResource PositiveBrush}"/>
                            <TextBlock Grid.Column="2" Text="+$320" Foreground="{ThemeResource PositiveBrush}" FontWeight="SemiBold"/>
                        </Grid>

                        <Grid Padding="12" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="MSFT" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="-50" Foreground="{ThemeResource NegativeBrush}"/>
                            <TextBlock Grid.Column="2" Text="-$420" Foreground="{ThemeResource NegativeBrush}" FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
