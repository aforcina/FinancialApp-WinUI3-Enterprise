<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FinancialApp.Presentation.Views.TradeBlotterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource AppBackgroundBrush}">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Filters -->
        <StackPanel Grid.Row="0" Spacing="12">
            <TextBlock Text="TRADE BLOTTER" Style="{StaticResource SubheaderTextStyle}"/>
            <TextBlock Text="Real-time order status, executions, and audit trail" Foreground="{ThemeResource TextSecondaryBrush}"/>
            
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                <ComboBox Width="140" Header="Filter by Status" Background="{ThemeResource SurfaceBrush}" Foreground="{ThemeResource TextPrimaryBrush}">
                    <ComboBoxItem Content="All" IsSelected="True"/>
                    <ComboBoxItem Content="Draft"/>
                    <ComboBoxItem Content="Submitted"/>
                    <ComboBoxItem Content="Approved"/>
                    <ComboBoxItem Content="Executed"/>
                    <ComboBoxItem Content="Rejected"/>
                </ComboBox>
                <ComboBox Width="140" Header="Filter by Side" Background="{ThemeResource SurfaceBrush}" Foreground="{ThemeResource TextPrimaryBrush}">
                    <ComboBoxItem Content="All" IsSelected="True"/>
                    <ComboBoxItem Content="Buy"/>
                    <ComboBoxItem Content="Sell"/>
                </ComboBox>
                <TextBox Width="180" PlaceholderText="Search by symbol..." Background="{ThemeResource SurfaceBrush}" Foreground="{ThemeResource TextPrimaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- Blotter Table -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Padding="16" Background="{ThemeResource ElevationBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="ORDER ID" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock Grid.Column="1" Text="SYMBOL" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock Grid.Column="2" Text="SIDE" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock Grid.Column="3" Text="QUANTITY" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock Grid.Column="4" Text="PRICE" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock Grid.Column="5" Text="STATUS" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock Grid.Column="6" Text="APPROVAL STATUS" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock Grid.Column="7" Text="TRADER" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock Grid.Column="8" Text="TIME" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock Grid.Column="9" Text="DETAIL" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12"/>
                </Grid>

                <!-- Data Rows -->
                <ListView Grid.Row="1" Background="Transparent">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="16,12" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Order ID -->
                                <TextBlock Text="ORD-001" FontFamily="Courier New" FontSize="11" Foreground="{ThemeResource AccentBlueBrush}" FontWeight="SemiBold"/>

                                <!-- Symbol -->
                                <TextBlock Grid.Column="1" Text="AAPL" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>

                                <!-- Side -->
                                <TextBlock Grid.Column="2" Text="BUY" Foreground="{ThemeResource PositiveBrush}" FontWeight="SemiBold" FontSize="11"/>

                                <!-- Quantity -->
                                <TextBlock Grid.Column="3" Text="100" Foreground="{ThemeResource TextPrimaryBrush}"/>

                                <!-- Price -->
                                <TextBlock Grid.Column="4" Text="$211.40" Foreground="{ThemeResource TextPrimaryBrush}"/>

                                <!-- Status -->
                                <Border Grid.Column="5" Background="#064E3B" CornerRadius="6" Padding="8,4" HorizontalAlignment="Fit">
                                    <TextBlock Text="EXECUTED" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource PositiveBrush}"/>
                                </Border>

                                <!-- Approval Status -->
                                <Border Grid.Column="6" Background="#164E63" CornerRadius="6" Padding="8,4" HorizontalAlignment="Fit">
                                    <TextBlock Text="APPROVED" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentCyanBrush}"/>
                                </Border>

                                <!-- Trader -->
                                <TextBlock Grid.Column="7" Text="John Smith" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12"/>

                                <!-- Time -->
                                <TextBlock Grid.Column="8" Text="14:23:15" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12"/>

                                <!-- Detail Button -->
                                <Button Grid.Column="9" Content="View" Style="{StaticResource SecondaryButtonStyle}" Padding="8,6" FontSize="11" HorizontalAlignment="Left"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                    <!-- Sample Rows -->
                    <ListViewItem/>
                    <ListViewItem/>
                    <ListViewItem/>
                    <ListViewItem/>
                    <ListViewItem/>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
