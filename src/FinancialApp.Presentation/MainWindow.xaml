<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FinancialApp.Presentation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Equity Trading Desk - Enterprise Edition"
    Width="1600"
    Height="900"
    Background="{ThemeResource AppBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Command Bar -->
        <Border Grid.Row="0" Background="{ThemeResource TopBarBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="16,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- Account Selector -->
                <ComboBox Grid.Column="0" 
                          Header="Account"
                          ItemsSource="{Binding Accounts}"
                          SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                          Width="180"
                          Background="{ThemeResource SurfaceBrush}"
                          Foreground="{ThemeResource TextPrimaryBrush}"/>

                <!-- Symbol Search -->
                <AutoSuggestBox Grid.Column="1"
                                PlaceholderText="Search symbol or trade..."
                                Width="420"
                                HorizontalAlignment="Left"
                                Margin="16,0,0,0"
                                Background="{ThemeResource SurfaceBrush}"
                                Foreground="{ThemeResource TextPrimaryBrush}"/>

                <!-- Right Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Market Status: OPEN" Foreground="{ThemeResource PositiveBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <Button Content="🔔 Alerts (3)" Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="⚙️ Settings" Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Layout: Navigation + Content + Side Panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Pane -->
            <Border Grid.Column="0" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Padding="12" Spacing="8">
                    <TextBlock Text="NAVIGATION" Style="{StaticResource MetricLabelStyle}" Margin="8,12"/>

                    <Button Content="📊 Dashboard" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            HorizontalAlignment="Stretch"
                            Command="{Binding NavigateToDashboardCommand}"/>

                    <Button Content="👁️ Watchlist" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            HorizontalAlignment="Stretch"
                            Command="{Binding NavigateToWatchlistCommand}"/>

                    <Button Content="📍 Positions" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            HorizontalAlignment="Stretch"
                            Command="{Binding NavigateToPositionsCommand}"/>

                    <Button Content="✏️ Trade Ticket" 
                            Style="{StaticResource PrimaryButtonStyle}" 
                            HorizontalAlignment="Stretch"
                            Command="{Binding NavigateToTradeTicketCommand}"/>

                    <Button Content="📋 Blotter" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            HorizontalAlignment="Stretch"
                            Command="{Binding NavigateToBlotterCommand}"/>

                    <Button Content="✅ Approvals" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            HorizontalAlignment="Stretch"
                            Command="{Binding NavigateToApprovalsCommand}"/>

                    <Button Content="🛡️ Risk" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            HorizontalAlignment="Stretch"
                            Command="{Binding NavigateToRiskCommand}"/>

                    <Button Content="📄 Reports" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            HorizontalAlignment="Stretch"
                            Command="{Binding NavigateToReportsCommand}"/>
                </StackPanel>
            </Border>

            <!-- Main Content Area -->
            <ScrollViewer Grid.Column="1" Padding="16" Background="{ThemeResource AppBackgroundBrush}">
                <Frame x:Name="MainContentFrame"/>
            </ScrollViewer>

            <!-- Right Side Panel: Selected Security Details -->
            <Border Grid.Column="2" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1,0,0,0" Padding="16">
                <ScrollViewer>
                    <StackPanel Spacing="16">
                        <TextBlock Text="SELECTED SECURITY" Style="{StaticResource SectionHeaderStyle}"/>
                        
                        <TextBlock Text="{Binding SelectedSymbol}" Style="{StaticResource HeroTextStyle}"/>
                        
                        <StackPanel>
                            <TextBlock Text="Last Trade" Style="{StaticResource MetricLabelStyle}"/>
                            <TextBlock Text="{Binding SelectedSecurityPrice}" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Change" Style="{StaticResource MetricLabelStyle}"/>
                            <TextBlock Text="{Binding SelectedSecurityChange}" FontSize="18" FontWeight="SemiBold" Foreground="{Binding SelectedSecurityChangeColor}"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Bid / Ask" Style="{StaticResource MetricLabelStyle}"/>
                            <TextBlock Text="{Binding SelectedSecurityBidAsk}" FontSize="16" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Position Size" Style="{StaticResource MetricLabelStyle}"/>
                            <TextBlock Text="{Binding SelectedSecurityPosition}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Daily Volume" Style="{StaticResource MetricLabelStyle}"/>
                            <TextBlock Text="{Binding SelectedSecurityVolume}" FontSize="16" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Risk Level" Style="{StaticResource MetricLabelStyle}"/>
                            <TextBlock Text="{Binding SelectedSecurityRiskLevel}" FontSize="18" FontWeight="SemiBold" Foreground="{Binding SelectedSecurityRiskColor}"/>
                        </StackPanel>

                        <Button Content="Trade This Security" 
                                Style="{StaticResource PrimaryButtonStyle}" 
                                HorizontalAlignment="Stretch"
                                Command="{Binding TradeSelectedSecurityCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
